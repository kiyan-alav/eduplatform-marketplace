model AdminProfile {
    id        Int      @id @default(autoincrement())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    userId    Int      @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

