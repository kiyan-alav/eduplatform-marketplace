model Category {
    id        Int      @id @default(autoincrement())
    name      String   @unique @db.VarChar(100)
    slug      String   @unique @db.VarChar(100)
    courses   Course[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([createdAt(sort: Desc)])
}

