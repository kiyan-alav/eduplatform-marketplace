model Course {
    id           Int               @id @default(autoincrement())
    title        String            @db.VarChar(255)
    description  String?           @db.Text
    instructor   InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    instructorId Int
    price        Int               @default(0)
    level        LevelType
    category     Category          @relation(fields: [categoryId], references: [id])
    categoryId   Int
    isPublished  Boolean           @default(false)
    cover        String?           @db.VarChar(2048)
    avgRating    Decimal           @default(0) @db.Decimal(4, 2)
    ratingCount  Int               @default(0)
    chapters     Chapter[]
    enrollments  Enrollment[]
    ratings      Rating[]
    createdAt    DateTime          @default(now())
    updatedAt    DateTime          @updatedAt

    @@index([instructorId])
    @@index([categoryId])
    @@index([isPublished, createdAt(sort: Desc)])
}