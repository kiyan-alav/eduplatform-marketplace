type SocialLinks {}

model InstructorProfile {
    id Int @id @default(autoincrement())
    user User @relation(fields: [userId], references: [id])
    userId Int @unique
    bio String?
    expertise String[]
    website String?
    instagram String?
    linkedin String?
    isVerified Boolean @default(false)
    verificationStatus InstructorRequestStatus @default(PENDING)
    bankAccount String?
    cardNumber String?
    sheba String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}